# Server
PORT=3210
HOST=127.0.0.1
# When binding to a LAN address, list every hostname allowed in HTTP Host headers.
ALLOWED_HOSTS=

# Text generation. You can also configure this in the app settings page.
ZHIPUAI_API_KEY=
MODEL_ID=glm-5.2

# Optional image generation. Leave empty to use image upload only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL_ID=gpt-image-2
